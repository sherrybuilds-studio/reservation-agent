# Copy to .env and fill in. Nothing reads .env by itself: export it into the
# shell before starting (set -a; . ./.env; set +a) or let your process manager
# load it. A setting left empty keeps that feature off.

# LLM replies and review reply drafts (OpenRouter)
OPENROUTER_API_KEY=

# Supabase (run setup.sql once). RESTAURANT_ID keys this restaurant's rows.
SUPABASE_URL=
SUPABASE_KEY=
RESTAURANT_ID=demo-restaurant

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token you choose for Meta's webhook handshake
VERIFY_TOKEN=
# App secret for the X-Hub-Signature-256 check. Required: while it is empty,
# every POST to /webhook is refused with 503.
WHATSAPP_APP_SECRET=

# Owner alerts and reports (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Review monitor: both are required, there are no defaults.
# GOOGLE_PLACE_ID is the Business Profile location path,
# accounts/<account_id>/locations/<location_id>.
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
